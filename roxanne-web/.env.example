# ─── Required ────────────────────────────────────────────────────────────────
# Public URL of the site (used for SEO canonical links, sitemap and social cards)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Dashboard login (https://your-site/admin). Use a long, unique password.
ADMIN_PASSWORD=change-me-to-a-long-password

# Random secret used to sign the dashboard session cookie (32+ characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ─── Storage ─────────────────────────────────────────────────────────────────
# Without these, edits/messages/photos are saved as files in ./data
# (perfect for a VPS, Railway, Render or Docker with a persistent volume).
# On Vercel (read-only disk) connect an Upstash Redis database and set:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# (KV_REST_API_URL / KV_REST_API_TOKEN from the Vercel marketplace also work.)

# ─── Optional integrations ───────────────────────────────────────────────────
# Calendly Personal Access Token → shows upcoming meetings in the dashboard.
# Calendly → Integrations & apps → API and webhooks → Personal access tokens.
# (It can also be pasted in Dashboard → Meetings.)
# CALENDLY_TOKEN=

# Email notification for each new contact message (https://resend.com)
# RESEND_API_KEY=
# RESEND_FROM="Website <website@your-domain.com>"
